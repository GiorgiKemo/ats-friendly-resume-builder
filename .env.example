# =============================================
# SUPABASE CONFIGURATION
# =============================================
# Your Supabase project URL
VITE_SUPABASE_URL=your_supabase_url
SUPABASE_URL=your_supabase_url
# Optional: use a separate Supabase project for local development
VITE_SUPABASE_URL_DEV=your_supabase_url_dev
# Your Supabase publishable key (safe for browser builds)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Optional: use a separate Supabase publishable key for local development
VITE_SUPABASE_PUBLISHABLE_KEY_DEV=sb_publishable_your-dev-publishable-key
# Your Supabase secret key (server/Edge Functions only)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Supabase Edge Function custom secrets cannot use the SUPABASE_ prefix.
SB_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SB_SECRET_KEY=sb_secret_your-secret-key
# Legacy fallback keys only if you have not migrated yet
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY_DEV=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Vercel server API only. Keep disabled until distributed ingress limits
# and log retention are approved; see docs/ENVIRONMENT_MATRIX.md. Never use VITE_.
CSP_REPORT_PERSISTENCE_ENABLED=false

# =============================================
# STRIPE CONFIGURATION
# =============================================
# Your Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Your Stripe secret key
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook secret for Stripe events
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Secret used to sign Gmail OAuth state. If omitted, Edge Functions fall back
# to GOOGLE_CLIENT_SECRET, but a dedicated high-entropy value is preferred.
GMAIL_OAUTH_STATE_SECRET=generate-a-long-random-secret
# Configure Brevo webhooks to send Authorization: Bearer <secret>.
BREVO_WEBHOOK_SECRET=generate-a-long-random-secret
INBOUND_WEBHOOK_SECRET=generate-a-long-random-secret
# Brevo API and SMTP configuration for transactional/contact flows.
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASSWORD=your-brevo-smtp-password
SMTP_ADMIN_EMAIL=no-reply@resumeats.cv
# Google OAuth credentials used by Gmail connect/callback Edge Functions.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Your public site URL
SITE_URL=https://resumeats.cv
# Comma-separated extra browser origins allowed to call checkout functions.
CORS_ADDITIONAL_ORIGINS=
# Pricing display configuration
VITE_STRIPE_CURRENCY=USD
VITE_STRIPE_PREMIUM_MONTHLY_AMOUNT=9.99
VITE_STRIPE_PREMIUM_YEARLY_AMOUNT=99.99
# Stripe price IDs for test mode
VITE_STRIPE_PRICE_PREMIUM_MONTHLY_TEST=price_test_monthly
VITE_STRIPE_PRICE_PREMIUM_YEARLY_TEST=price_test_yearly
STRIPE_PRICE_PREMIUM_MONTHLY_TEST=price_test_monthly
STRIPE_PRICE_PREMIUM_YEARLY_TEST=price_test_yearly
# Stripe price IDs for live mode
VITE_STRIPE_PRICE_PREMIUM_MONTHLY_LIVE=price_live_monthly
VITE_STRIPE_PRICE_PREMIUM_YEARLY_LIVE=price_live_yearly
STRIPE_PRICE_PREMIUM_MONTHLY_LIVE=price_live_monthly
STRIPE_PRICE_PREMIUM_YEARLY_LIVE=price_live_yearly
# Optional extra allowlist entries for checkout validation
ALLOWED_STRIPE_PRICE_IDS=
# Success and cancel URLs for Stripe checkout
VITE_STRIPE_SUCCESS_URL=https://resumeats.cv/#/subscription/success
VITE_STRIPE_CANCEL_URL=https://resumeats.cv/#/pricing

# =============================================
# AI PROVIDER CONFIGURATION
# =============================================
# OpenRouter is the primary provider. Groq is used automatically as fallback when OpenRouter is unavailable.
AI_PROVIDER=openrouter
VITE_AI_PROVIDER=openrouter

# OpenRouter API key (server-side only)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_APP_TITLE=ResumeATS
OPENROUTER_REASONING_EFFORT=minimal
OPENROUTER_EXCLUDE_REASONING=true

# Groq fallback (server-side only)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# =============================================
# JOB DISCOVERY CONFIGURATION
# =============================================
# Optional: Bright Data token for LinkedIn job discovery in auto-apply
BRIGHT_DATA_API_TOKEN=your-bright-data-api-token
# Optional: override the default Bright Data LinkedIn jobs dataset id
BRIGHT_DATA_LINKEDIN_DATASET_ID=gd_lpfll7v5hcqtkxl6l
# Optional: JSearch RapidAPI key for additional non-LinkedIn job discovery
JSEARCH_API_KEY=your-jsearch-rapidapi-key

# =============================================
# APPLICATION CONFIGURATION
# =============================================
# Production mode
NODE_ENV=production
# Application URL
VITE_APP_URL=https://resumeats.cv
# Google Analytics 4 Measurement ID (for example: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Optional local-only kill switch for auth/security event reporting.
VITE_DISABLE_SYSTEM_LOGGING=false
# Feature flags
VITE_FEATURE_ENHANCED_AI=true
VITE_FEATURE_PREMIUM_TEMPLATES=true
# Maximum number of free resumes
VITE_MAX_FREE_RESUMES=3
