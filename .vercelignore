supabase/.temp
supabase/.branches

# Ignore test files and generated reports
tests
coverage
test-results
playwright-report
**/*.test.js
**/*.spec.js
**/__tests__

# Extension sources are packaged separately, not deployed with the web app
browser-agent

# Ignore documentation files
*.md
!README.md

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
