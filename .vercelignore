# Ignore development files
node_modules
dist
dist-extension
.git
.github
.vscode

# Ignore deployment scripts
deploy-edge-functions.sh
deploy-to-vercel.sh
*.sh

# Ignore non-runtime website assets
browser-agent-training
training
brevo-templates
deployment

# Ignore environment files except .env.production
.env
.env.*
.env.local
.env.development
.env.functions

