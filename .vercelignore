# Ignore development files
node_modules
dist
dist-extension
.git
.github
.vscode

# Ignore deployment scripts
*.sh

# Ignore non-runtime website assets
browser-agent-training
training
brevo-templates

# Ignore environment files except .env.production
.env
.env.*
.env.local
.env.development
.env.functions

# Ignore Supabase local development files
supabase/.temp
supabase/.branches

# Ignore test files and generated reports
tests
coverage
test-results
playwright-report
**/*.test.js
**/*.spec.js
**/__tests__

# Extension sources are packaged separately, not deployed with the web app.
# The web app imports this DOM-free shared helper at build time.
browser-agent/*
!browser-agent/vacancy-experience.js

# Ignore documentation files
*.md
!README.md

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
