{
  "name": "ats-friendly-resume-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.6.4 <12"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build && node scripts/prerender-public-routes.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:website:smoke": "node tests/playwright/route-smoke.mjs",
    "test:website:full": "node tests/playwright/full-website-qa.mjs",
    "test:extension:chromium": "node tests/playwright/extension-qa.mjs --extension-path=dist-extension --browser=chromium",
    "check:supabase:functions": "node scripts/check-supabase-functions.mjs",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "deploy:supabase:db": "supabase db push --linked",
    "deploy:supabase:functions": "supabase functions deploy",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "date-fns": "^4.1.0",
    "docx": "^9.4.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.9.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/react": "^18.0.15",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.15",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "supabase": "^2.22.6",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.3.1"
  }
}
