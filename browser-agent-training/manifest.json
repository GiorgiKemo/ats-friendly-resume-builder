{
  "manifest_version": 3,
  "name": "ResumeATS Autofill Trainer",
  "version": "0.2.2",
  "version_name": "0.2.2 Trainer",
  "description": "Training-only copy of the ResumeATS browser agent. Autofills application forms, captures user corrections, and exports local autofill planner datasets.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "webNavigation",
    "downloads"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ResumeATS Autofill Trainer",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-form-bridge.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://resumeats.cv/*",
        "https://www.resumeats.cv/*"
      ],
      "js": [
        "content-app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-form-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autofill-safety.js",
        "content-job-board.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
